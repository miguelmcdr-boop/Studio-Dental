# Variables de entorno de Supabase (F4-02)
# Copiar este archivo a .env y completar con valores reales
# NO commitear el archivo .env a git

VITE_SUPABASE_URL=tu-supabase-url
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Feature flag para activar/desactivar Supabase
# true = usar Supabase, false = usar localStorage (fallback)
VITE_USE_SUPABASE=true

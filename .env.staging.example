# ============================================================
# Variables de entorno — Supabase STAGING (F6-I)
# ============================================================
#
# Este archivo es una PLANTILLA para el entorno de staging.
# NO commitear valores reales. Copiar a .env.local para
# desarrollo local contra staging.
#
# En Vercel: configurar estas variables en
#   Settings → Environment Variables → Environment: Preview
#
# Cómo obtener los valores:
#   1. Ir a https://supabase.com/dashboard
#   2. Seleccionar el proyecto de staging (studio-dental-staging)
#   3. Settings → API → copiar "Project URL" y "anon public key"
#
# ============================================================

# URL del proyecto Supabase de staging
VITE_SUPABASE_URL=https://<tu-staging-project-ref>.supabase.co

# Anon key del proyecto Supabase de staging
VITE_SUPABASE_ANON_KEY=<anon-key-del-proyecto-staging>

# Feature flag: true = usar Supabase, false = fallback a localStorage
VITE_USE_SUPABASE=true

# Identificador de entorno (para logging/debug en consola)
VITE_ENVIRONMENT=staging
